{
    "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: LLVM, UseTab: Never, IndentWidth: 4, TabWidth: 4, BreakBeforeBraces: Attach, AllowShortIfStatementsOnASingleLine: true, IndentCaseLabels: false, ColumnLimit: 0, AccessModifierOffset: -2 }",
    // Editor
    "editor.bracketPairColorization.enabled": false,
    "editor.fontSize": 14,
    "editor.language.brackets": [],
    "editor.tabSize": 4,
    "editor.indentSize": 4,
    "files.autoSave": "afterDelay",
    "security.workspace.trust.untrustedFiles": "open",
    "python.analysis.extraPaths": [],
    "[cpp]": {
        "editor.wordBasedSuggestions": "off",
        "editor.suggest.insertMode": "replace",
        "editor.semanticHighlighting.enabled": true,
        "editor.tabSize": 4
    },
    "json.schemas": [],
    // Git
    "git.autofetch": true,
    "git.terminalAuthentication": false,
    "git.confirmSync": false,
    // Code Runner
    "code-runner.runInTerminal": true,
    "code-runner.executorMap": {
        "cpp": "cd $dir && clang++ -std=c++17 -stdlib=libc++ $fileName -o $fileNameWithoutExt.out && $dir$fileNameWithoutExt.out && rm $dir$fileNameWithoutExt.out",
        "c": "cd $dir && gcc -std=c11 $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt && rm $dir$fileNameWithoutExt",
        // "cpp": "cd $dir && clang++ -std=c++17 -stdlib=libc++ $fileName -o $fileNameWithoutExt.exe && $dir$fileNameWithoutExt.exe",
        "python": "cd $dir && python3 -u $fileName",
    },
    "code-runner.languageIdToFileExtensionMap": {
        "bat": ".bat",
        "powershell": ".ps1",
        "typescript": ".ts",
    },
    // Live Server
    "liveServer.settings.donotShowInfoMsg": true,
    "liveServer.settings.donotVerifyTags": true,
    "[c]": {
        "editor.tabSize": 4,
    },
    "[javascript]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[typescript]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[typescriptreact]": {
        "editor.tabSize": 2,
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "notebook.formatOnSave.enabled": true,
    "[python]": {
        "editor.tabSize": 4,
        "editor.formatOnType": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        // "editor.defaultFormatter": "charliermarsh.ruff",
    },
    "[css]": {
        "editor.tabSize": 4
    },
    "[html]": {
        "editor.tabSize": 4
    },
    "[go]": {
        "editor.defaultFormatter": "golang.go"
    },
    "[markdown]": {
        "editor.tabSize": 4,
        "editor.defaultFormatter": "yzhang.markdown-all-in-one"
    },
    "notebook.lineNumbers": "on",
    // latex
    "latex-workshop.latex.autoBuild.run": "onSave",
    // Terminal
    "terminal.external.osxExec": "iTerm2",
    "terminal.integrated.fontFamily": "MesloLGS NF",
    "terminal.integrated.fontSize": 14,
    // Jupyter
    "jupyter.interactiveWindow.creationMode": "perFile",
    "jupyter.interactiveWindow.textEditor.executeSelection": true,
    "C_Cpp.intelliSenseCacheSize": 0,
    // "diffEditor.hideUnchangedRegions.enabled": true,
    // workbench
    "workbench.startupEditor": "none",
    "workbench.colorTheme": "GitHub Dark",
    "workbench.colorCustomizations": {},
    "workbench.iconTheme": "material-icon-theme",
    // GitHub Copilot
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false,
        "log": true
    },
    "aws.telemetry": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "application.shellEnvironmentResolutionTimeout": 15,
    "cmake.configureOnOpen": true,
    "cmake.showOptionsMovedNotification": false,
    "github.copilot.editor.enableAutoCompletions": true,
    "go.toolsManagement.autoUpdate": true,
    // Markdown Preview Github Styles
    "markdown-preview-github-styles.colorTheme": "dark",
    "editor.wordWrap": "on",
    "files.associations": {
        "*.css": "css"
    },
    "javascript.updateImportsOnFileMove.enabled": "never",
    "workbench.navigationControl.enabled": false,
    "diffEditor.codeLens": true,
    "github.copilot.nextEditSuggestions.enabled": false,
    "chat.instructionsFilesLocations": {
        ".github/instructions": true,
        "/var/folders/r6/7l4wrzxn2b1536z06d9p994m0000gn/T/postman-http-request-post-response.instructions.md": true,
        "/var/folders/r6/7l4wrzxn2b1536z06d9p994m0000gn/T/postman-http-request-pre-request.instructions.md": true,
        "/var/folders/r6/7l4wrzxn2b1536z06d9p994m0000gn/T/postman-collections-post-response.instructions.md": true,
        "/var/folders/r6/7l4wrzxn2b1536z06d9p994m0000gn/T/postman-collections-pre-request.instructions.md": true,
        "/var/folders/r6/7l4wrzxn2b1536z06d9p994m0000gn/T/postman-folder-post-response.instructions.md": true,
        "/var/folders/r6/7l4wrzxn2b1536z06d9p994m0000gn/T/postman-folder-pre-request.instructions.md": true,
        "/var/folders/3q/2s6_c7553wz6m3jfzp9pgkfw0000gn/T/postman-collections-post-response.instructions.md": true,
        "/var/folders/3q/2s6_c7553wz6m3jfzp9pgkfw0000gn/T/postman-collections-pre-request.instructions.md": true,
        "/var/folders/3q/2s6_c7553wz6m3jfzp9pgkfw0000gn/T/postman-folder-post-response.instructions.md": true,
        "/var/folders/3q/2s6_c7553wz6m3jfzp9pgkfw0000gn/T/postman-folder-pre-request.instructions.md": true,
        "/var/folders/3q/2s6_c7553wz6m3jfzp9pgkfw0000gn/T/postman-http-request-post-response.instructions.md": true,
        "/var/folders/3q/2s6_c7553wz6m3jfzp9pgkfw0000gn/T/postman-http-request-pre-request.instructions.md": true
    },
    "[mdx]": {
        "editor.defaultFormatter": "unifiedjs.vscode-mdx"
    },
    "explorer.compactFolders": false,
    "terminal.integrated.suggest.enabled": true,
    "window.zoomLevel": 1,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "problems.autoReveal": false,
}